{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/atomics/**/*.ts",
    "src/atomics/**/*.tsx",
    "src/domains/**/*.ts",
    "src/domains/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/types/**/*.d.ts"
  ]
}
